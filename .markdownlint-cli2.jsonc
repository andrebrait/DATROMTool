{
  // markdownlint-cli2 runner config (globs + ignores). Rule set lives in
  // `.markdownlint.jsonc`. Run from the repo root: `npx markdownlint-cli2`
  // (add `--fix` to auto-fix). Lints the repo's own authored docs (AGENTS.md,
  // CLAUDE.md, .agents/policy/, .agents/context/); skips dependency
  // trees and the VENDORED third-party skill trees. Scoped to the agent-
  // guidance corpus (this is the surface the policy owns); the project's own
  // pre-existing READMEs/module docs are out of scope until someone opts them
  // in by widening these globs.
  "globs": ["AGENTS.md", "CLAUDE.md", ".agents/**/*.md"],
  "ignores": [
    "node_modules",
    "**/node_modules/**",
    ".venv",
    "**/.venv/**",
    "vendor",
    "**/vendor/**",
    "target",
    "**/target/**",
    // Vendored third-party plugin skills (upstream content, copied
    // byte-identical so managed/cloud sessions can load them without plugin
    // machinery): not ours to lint — fixing them here would drift from
    // upstream. .agents/skills/<name> is canonical; .claude/skills/<name> is a
    // symlink onto it, but the glob walker follows symlinked directories, so
    // both trees need an entry or the same files get linted twice.
    ".agents/skills/**",
    ".claude/skills/**",
    // Agent worktrees are full checkouts — never lint them.
    ".claude/worktrees/**"
  ]
}
